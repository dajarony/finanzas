{
  "critics": ["gauntlet-logic", "gauntlet-code", "gauntlet-contract"],
  "breaker": {"same_defect": 5, "no_progress": 3},
  "gates": [
    {"id": "test", "cmd": ["node", "--run", "test"], "timeout_s": 300},
    {"id": "check", "cmd": ["node", "--run", "check"], "timeout_s": 300},
    {"id": "build", "cmd": ["node", "--run", "build"], "timeout_s": 600}
  ],
  "protected": [
    "tests/*",
    "package.json",
    "package-lock.json",
    ".github/*"
  ]
}
